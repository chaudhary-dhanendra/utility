<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF3F5F8" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFF8F9FB" />
    <SolidColorBrush x:Key="RibbonBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FFD5DAE2" />
    <SolidColorBrush x:Key="SplitterBrush" Color="#FFE3E7ED" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF1E293B" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF5F6B7A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF2563EB" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#FF1E3A5F" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#FFFFFFFF" />

    <Style TargetType="{x:Type Window}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="32" />
    </Style>
</ResourceDictionary>
