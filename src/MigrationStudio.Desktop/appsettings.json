{
  "Infrastructure": {
    "OperationQueueCapacity": 100
  },
  "Production": {
    "ConnectionTimeoutSeconds": 15,
    "CommandTimeoutSeconds": 120,
    "MaximumConcurrentTables": 4,
    "MaximumConcurrentReaders": 4,
    "MaximumConcurrentWriters": 4,
    "BatchRowCount": 5000,
    "BatchByteSize": 33554432,
    "CheckpointFrequencyBatches": 1,
    "PostgreSqlTargetVersion": 17,
    "ReportOutputDirectory": "Reports",
    "LoggingLevel": "Information",
    "UpdateChannel": "Stable",
    "EnablePreviewFeatures": false,
    "SensitiveColumnPatterns": [
      "password",
      "passwd",
      "secret",
      "token",
      "api_key",
      "private_key",
      "credential"
    ]
  },
  "Plugins": {
    "Enabled": false,
    "RequireAuthenticodeSignature": true,
    "TrustedPublisherThumbprints": []
  }
}
