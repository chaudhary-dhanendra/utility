<UserControl x:Class="MigrationStudio.Desktop.Views.MigrationWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MigrationStudio.Desktop.Converters"
             xmlns:inventory="clr-namespace:MigrationStudio.Domain.Inventory;assembly=MigrationStudio.Domain"
             xmlns:vm="clr-namespace:MigrationStudio.Desktop.ViewModels">
    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="WizardInverseBooleanConverter" />
        <BooleanToVisibilityConverter x:Key="WizardBooleanToVisibilityConverter" />
        <Style x:Key="StepPanelStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        </Style>
        <Style x:Key="MetricStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,24,4" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="10" Margin="0,0,0,14"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="3" Padding="6"
                                Command="{Binding DataContext.GoToStepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Step}">
                            <StackPanel>
                                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold"
                                           Text="{Binding Title}" />
                                <TextBlock HorizontalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding State}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid x:Name="ConnectPanel">
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource StepPanelStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnectStep}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Connect" />
                        <TextBlock Margin="0,6,0,22" Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Connect the SQL Server source and PostgreSQL target." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SectionBorderStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="SQL Server source" />
                                    <TextBlock Margin="0,12,0,4" Text="Server" />
                                    <TextBox Text="{Binding Workspace.Server, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Margin="0,12,0,4" Content="Use Windows authentication"
                                              IsChecked="{Binding Workspace.UseWindowsAuthentication}" />
                                    <TextBlock Margin="0,8,0,4" Text="Username" />
                                    <TextBox IsEnabled="{Binding Workspace.UseWindowsAuthentication, Converter={StaticResource WizardInverseBooleanConverter}}"
                                             Text="{Binding Workspace.Username, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,8,0,4" Text="Password" />
                                    <PasswordBox x:Name="SqlServerPasswordBox"
                                                 IsEnabled="{Binding Workspace.UseWindowsAuthentication, Converter={StaticResource WizardInverseBooleanConverter}}"
                                                 PasswordChanged="SqlServerPasswordBox_OnPasswordChanged" />
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <CheckBox Content="Encrypt" IsChecked="{Binding Workspace.Encrypt}" />
                                        <CheckBox Margin="18,0,0,0" Content="Trust server certificate"
                                                  IsChecked="{Binding Workspace.TrustServerCertificate}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,10,0,4" Text="Database" />
                                    <ComboBox IsEditable="True" ItemsSource="{Binding Workspace.Databases}"
                                              SelectedItem="{Binding Workspace.SelectedDatabase}" />
                                    <Button Width="130" Margin="0,16,0,0" HorizontalAlignment="Left"
                                            Command="{Binding TestSourceCommand}" Content="Test Source" />
                                    <TextBlock Margin="0,10,0,0" Text="{Binding Workspace.ConnectionStatus}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource SectionBorderStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="PostgreSQL target" />
                                    <TextBlock Margin="0,12,0,4" Text="Host" />
                                    <TextBox Text="{Binding Workspace.PostgreSqlTarget.Host, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,8,0,4" Text="Port" />
                                    <TextBox Text="{Binding Workspace.PostgreSqlTarget.Port}" />
                                    <TextBlock Margin="0,8,0,4" Text="Database" />
                                    <TextBox Text="{Binding Workspace.PostgreSqlTarget.Database, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,8,0,4" Text="Username" />
                                    <TextBox Text="{Binding Workspace.PostgreSqlTarget.Username, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,8,0,4" Text="Password" />
                                    <PasswordBox x:Name="PostgreSqlPasswordBox"
                                                 PasswordChanged="PostgreSqlPasswordBox_OnPasswordChanged" />
                                    <Expander Margin="0,12,0,0" Header="Advanced connection settings">
                                        <StackPanel Margin="12">
                                            <CheckBox Content="Use SSL" IsChecked="{Binding Workspace.PostgreSqlTarget.UseSsl}" />
                                            <CheckBox Margin="0,8,0,0" Content="Trust server certificate"
                                                      IsChecked="{Binding Workspace.PostgreSqlTarget.TrustServerCertificate}" />
                                        </StackPanel>
                                    </Expander>
                                    <Button Width="130" Margin="0,16,0,0" HorizontalAlignment="Left"
                                            Command="{Binding TestTargetCommand}" Content="Test Target" />
                                    <TextBlock Margin="0,10,0,0" Text="{Binding Workspace.PostgreSqlTarget.ConnectionStatus}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid x:Name="SelectPanel">
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource StepPanelStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelectStep}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Select" />
                        <TextBlock Margin="0,6,0,18" Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Choose the database objects and data to migrate." />
                        <TextBlock FontWeight="SemiBold" Text="Selection mode" />
                        <ComboBox Width="260" Margin="0,6,0,16" HorizontalAlignment="Left"
                                  ItemsSource="{Binding SelectionModes}"
                                  SelectedItem="{Binding Workspace.ScopeMode}" />
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Workspace.ScopeMode}"
                                                     Value="{x:Static inventory:MigrationScopeMode.SelectedSchemas}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Schemas" />
                            <ListBox Height="230" ItemsSource="{Binding Workspace.Schemas}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Workspace.ScopeMode}"
                                                     Value="{x:Static inventory:MigrationScopeMode.ExcelSelectedTables}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock FontWeight="SemiBold" Text="Excel selection" />
                            <DockPanel Margin="0,6,0,0">
                                <Button Width="130" DockPanel.Dock="Right"
                                        Command="{Binding Workspace.BrowseExcelCommand}"
                                        Content="Choose workbook" />
                                <TextBox Margin="0,0,10,0" IsReadOnly="True"
                                         Text="{Binding Workspace.ExcelPath, Mode=OneWay}" />
                            </DockPanel>
                            <Button Width="130" Margin="0,8,0,0" HorizontalAlignment="Left"
                                    Command="{Binding Workspace.MatchExcelCommand}" Content="Match selection" />
                        </StackPanel>
                        <WrapPanel Margin="0,18,0,12">
                            <TextBlock Style="{StaticResource MetricStyle}"
                                       Text="{Binding SelectedSchemaCount, StringFormat=Schemas selected: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}"
                                       Text="{Binding SelectedTableCount, StringFormat=Tables selected: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}"
                                       Text="{Binding EstimatedRows, StringFormat=Estimated rows: {0:N0}}" />
                        </WrapPanel>
                        <Button Width="130" HorizontalAlignment="Left"
                                Command="{Binding ConfirmSelectionCommand}" Content="Analyze" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="AnalyzePanel">
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource StepPanelStyle}">
                            <Style.Triggers><DataTrigger Binding="{Binding IsAnalyzeStep}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Analyze" />
                        <TextBlock Margin="0,6,0,18" Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Assess compatibility, dependencies, and migration risks." />
                        <WrapPanel>
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding TableCount, StringFormat=Tables: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding ViewCount, StringFormat=Views: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding ProcedureCount, StringFormat=Procedures: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding FunctionCount, StringFormat=Functions: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding TriggerCount, StringFormat=Triggers: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding WarningCount, StringFormat=Warnings: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding BlockerCount, StringFormat=Blockers: {0:N0}}" />
                        </WrapPanel>
                        <ProgressBar Height="16" Margin="0,14,0,8" Maximum="100" Value="{Binding Workspace.Progress}" />
                        <TextBlock Text="{Binding Workspace.Status}" TextWrapping="Wrap" />
                        <Button Width="130" Margin="0,18,0,0" HorizontalAlignment="Left"
                                Command="{Binding AnalyzeCommand}" Content="Analyze" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="ConvertPanel">
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource StepPanelStyle}">
                            <Style.Triggers><DataTrigger Binding="{Binding IsConvertStep}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Convert" />
                        <TextBlock Margin="0,6,0,18" Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Create PostgreSQL objects and a verified migration package." />
                        <WrapPanel>
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding SelectedObjectCount, StringFormat=Selected: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding ConvertedObjectCount, StringFormat=Objects converted: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding PackagedObjectCount, StringFormat=Packaged: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding ExecutableObjectCount, StringFormat=Executable: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding ManualReviewObjectCount, StringFormat=Manual review: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding UnsupportedObjectCount, StringFormat=Unsupported: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.LiveValidationPassedCount, StringFormat=Validated passed: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.LiveValidationFailedCount, StringFormat=Validation failed: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.LiveValidationBlockedCount, StringFormat=Dependency blocked: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.LiveValidationNotRunCount, StringFormat=Not run: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.LiveValidationManualReviewCount, StringFormat=Manual review: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.LiveValidationReusedCount, StringFormat=Reused: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding AutomaticallyRenamedCount, StringFormat=Automatically renamed: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding UnresolvedMappingCount, StringFormat=Unresolved required: {0:N0}}" />
                        </WrapPanel>
                        <ProgressBar Height="16" Margin="0,14,0,8" Maximum="100" Value="{Binding Workspace.Progress}" />
                        <TextBlock Text="{Binding Workspace.ConversionStatus}" TextWrapping="Wrap" />
                        <ProgressBar Height="12" Margin="0,8,0,4" Maximum="100"
                                     Value="{Binding Workspace.LiveValidationProgress}" />
                        <TextBlock Text="{Binding Workspace.LiveValidationStatus}" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource MetricStyle}"
                                       Text="{Binding Workspace.ConversionProcessed, StringFormat=Processed: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}"
                                       Text="{Binding Workspace.ConversionTotal, StringFormat=Total: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}"
                                       Text="{Binding Workspace.ConversionObjectsPerSecond, StringFormat=Items/sec: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}"
                                       Text="{Binding Workspace.ConversionElapsed, StringFormat=Elapsed: {0:g}}" />
                            <TextBlock Style="{StaticResource MetricStyle}"
                                       Text="{Binding Workspace.ConversionCurrentStage, StringFormat=Stage: {0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}"
                                       Text="{Binding Workspace.ConversionCurrentObjectType, StringFormat=Current type: {0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}"
                                       Text="{Binding Workspace.ConversionCurrentObject, StringFormat=Current object: {0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}"
                                       Text="{Binding Workspace.ConversionLastProgressAt, StringFormat=Last progress: {0:T}}" />
                            <TextBlock Style="{StaticResource MetricStyle}"
                                       Text="{Binding Workspace.ConversionIsResponsive, StringFormat=Responsive: {0}}" />
                        </WrapPanel>
                        <Button Width="130" Margin="0,18,0,0" HorizontalAlignment="Left"
                                Command="{Binding ConvertCommand}" Content="Convert and validate" />
                        <Expander Margin="0,14,0,0" Header="Live validation failures">
                            <DataGrid MaxHeight="220" AutoGenerateColumns="False" IsReadOnly="True"
                                      ItemsSource="{Binding Workspace.LiveValidationFailures}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="2*" Binding="{Binding ObjectName}" Header="Object" />
                                    <DataGridTextColumn Binding="{Binding Script}" Header="Script" />
                                    <DataGridTextColumn Binding="{Binding SqlState}" Header="SQLSTATE" />
                                    <DataGridTextColumn Binding="{Binding LineNumber}" Header="Line" />
                                    <DataGridTextColumn Width="2*" Binding="{Binding Dependency}" Header="Dependency" />
                                    <DataGridTextColumn Width="3*" Binding="{Binding PostgreSqlError}" Header="PostgreSQL error" />
                                    <DataGridTextColumn Width="3*" Binding="{Binding SuggestedFix}" Header="Suggested fix" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                    </StackPanel>
                </Grid>

                <Grid x:Name="DeployPanel">
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource StepPanelStyle}">
                            <Style.Triggers><DataTrigger Binding="{Binding IsDeployStep}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Deploy" />
                        <TextBlock Margin="0,6,0,18" Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Prepare PostgreSQL and deploy the converted schema." />
                        <WrapPanel>
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.DeploymentServerVersion, StringFormat=PostgreSQL version: {0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.DeploymentArtifactCount, StringFormat=Objects to create: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.DeploymentEquivalentObjectCount, StringFormat=Equivalent objects to retain: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.DeploymentActualConflictCount, StringFormat=Actual target conflicts: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.DeploymentPackageDuplicateCount, StringFormat=Package duplicates: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.DeploymentBlockingFindingCount, StringFormat=Blocking findings: {0:N0}}" />
                        </WrapPanel>
                        <ProgressBar Height="16" Margin="0,14,0,8" Maximum="100" Value="{Binding Workspace.DeploymentProgress}" />
                        <TextBlock Text="{Binding Workspace.DeploymentStatus}" TextWrapping="Wrap" />
                        <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                            <Button Width="150" Command="{Binding AssessTargetCommand}" Content="Check Target" />
                            <Button Width="150" Margin="10,0,0,0" Command="{Binding DeployCommand}" Content="Deploy Schema" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid x:Name="MigratePanel">
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource StepPanelStyle}">
                            <Style.Triggers><DataTrigger Binding="{Binding IsMigrateStep}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Migrate" />
                        <TextBlock Margin="0,6,0,18" Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Transfer table data with automatic checkpoints." />
                        <WrapPanel>
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.StreamingCurrentTable, StringFormat=Current table: {0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.TotalRowsRead, StringFormat=Rows read: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.TotalRowsWritten, StringFormat=Rows written: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.TotalRowsRejected, StringFormat=Rejected: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.DataRowsPerSecond, StringFormat=Rows/sec: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.TargetExistingTables, StringFormat=Target tables present: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.TargetMissingTables, StringFormat=Target tables missing: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.TargetExistingColumns, StringFormat=Target columns present: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.TargetMissingColumns, StringFormat=Target columns missing: {0:N0}}" />
                        </WrapPanel>
                        <ProgressBar Height="16" Margin="0,14,0,8" Maximum="100" Value="{Binding Workspace.Progress}" />
                        <TextBlock Text="{Binding Workspace.DataMigrationStatus}" TextWrapping="Wrap" />
                        <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                            <Button Width="110" Command="{Binding MigrateCommand}" Content="Start" />
                            <Button Width="110" Margin="8,0,0,0" Command="{Binding PauseMigrationCommand}" Content="Pause" />
                            <Button Width="110" Margin="8,0,0,0" Command="{Binding ResumeMigrationCommand}" Content="Resume" />
                            <Button Width="110" Margin="8,0,0,0" Command="{Binding CancelMigrationCommand}" Content="Cancel" />
                        </StackPanel>
                        <Expander Margin="0,18,0,0" Header="Failure details">
                            <StackPanel Margin="12">
                                <TextBlock Text="{Binding Workspace.StreamingFailureStage, StringFormat=Failure stage: {0}}" />
                                <TextBlock Text="{Binding Workspace.StreamingFailureComponent, StringFormat=Component: {0}}" />
                                <TextBlock Text="{Binding Workspace.StreamingFailureReason, StringFormat=Reason: {0}}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Workspace.StreamingRemediation, StringFormat=Remediation: {0}}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ValidatePanel">
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource StepPanelStyle}">
                            <Style.Triggers><DataTrigger Binding="{Binding IsValidateStep}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Validate" />
                        <TextBlock Margin="0,6,0,18" Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Compare source and target and identify discrepancies." />
                        <WrapPanel>
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.ReadinessStatus, StringFormat=Result: {0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.ValidationFindings.Count, StringFormat=Findings: {0:N0}}" />
                            <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.ValidationCriticalBlockers, StringFormat=Failed: {0:N0}}" />
                        </WrapPanel>
                        <ProgressBar Height="16" Margin="0,14,0,8" Maximum="100" Value="{Binding Workspace.ValidationProgress}" />
                        <TextBlock Text="{Binding Workspace.ValidationStatus}" TextWrapping="Wrap" />
                        <Button Width="150" Margin="0,18,0,0" HorizontalAlignment="Left"
                                Command="{Binding ValidateCommand}" Content="Run Validation" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="FinishPanel">
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource StepPanelStyle}">
                            <Style.Triggers><DataTrigger Binding="{Binding IsFinishStep}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Migration complete" />
                        <TextBlock Margin="0,6,0,18" Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Review the migration outcome and reports." />
                        <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.SelectedDatabase, StringFormat=Source database: {0}}" />
                        <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.PostgreSqlTarget.Database, StringFormat=Target database: {0}}" />
                        <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding SelectedSchemaCount, StringFormat=Schemas migrated: {0:N0}}" />
                        <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding SelectedTableCount, StringFormat=Tables migrated: {0:N0}}" />
                        <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.TotalRowsWritten, StringFormat=Rows migrated: {0:N0}}" />
                        <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.TotalRowsRejected, StringFormat=Rejected rows: {0:N0}}" />
                        <TextBlock Style="{StaticResource MetricStyle}" Text="{Binding Workspace.DeploymentCompleted, StringFormat=Objects deployed: {0:N0}}" />
                        <TextBlock Margin="0,24,0,6" FontSize="20" FontWeight="SemiBold" Text="Reports" />
                        <Separator Margin="0,0,0,12" />
                        <Button Width="150" HorizontalAlignment="Left"
                                Command="{Binding GenerateReportsCommand}" Content="Generate Reports" />
                        <ProgressBar Height="12" Margin="0,12,0,6" Maximum="100"
                                     Value="{Binding ReportProgress}"
                                     Visibility="{Binding IsGeneratingReports, Converter={StaticResource WizardBooleanToVisibilityConverter}}" />
                        <TextBlock Margin="0,8,0,0" Text="{Binding ReportStatus}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0" FontFamily="Consolas" Text="{Binding ReportDirectory}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasGeneratedReports, Converter={StaticResource WizardBooleanToVisibilityConverter}}" />
                        <Button Width="160" Margin="0,10,0,0" HorizontalAlignment="Left"
                                Command="{Binding OpenReportsFolderCommand}" Content="Open Reports Folder"
                                Visibility="{Binding HasGeneratedReports, Converter={StaticResource WizardBooleanToVisibilityConverter}}" />
                        <Button Width="130" Margin="0,18,0,0" HorizontalAlignment="Left"
                                Command="{Binding CompleteWorkflowCommand}" Content="Finish" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,14,0,0" Padding="10"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0">
            <DockPanel>
                <Button Width="100" DockPanel.Dock="Left" Command="{Binding BackCommand}" Content="Back" />
                <Button Width="100" DockPanel.Dock="Right" Command="{Binding NextCommand}" Content="Next" />
                <Button x:Name="CancelActiveOperationButton"
                        Width="150" Margin="12,0" DockPanel.Dock="Right"
                        Command="{Binding CancelCurrentOperationCommand}"
                        Content="{Binding CancelActionText}"
                        Visibility="{Binding IsCancelVisible, Converter={StaticResource WizardBooleanToVisibilityConverter}}" />
                <TextBlock Margin="16,0" VerticalAlignment="Center" TextAlignment="Center"
                           Text="{Binding WorkflowMessage}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
