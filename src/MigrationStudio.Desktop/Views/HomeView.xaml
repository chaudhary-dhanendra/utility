<UserControl x:Class="MigrationStudio.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding Title}" />
        <TextBlock Grid.Row="1" MaxWidth="760" Margin="0,12,0,0"
                   HorizontalAlignment="Left" Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="{Binding Description}" TextWrapping="Wrap" />
        <UniformGrid Grid.Row="2" Margin="0,32,0,0" Columns="3" VerticalAlignment="Top">
            <Border Margin="0,0,12,0" Padding="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="1. Connect" />
                    <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Configure SQL Server and PostgreSQL endpoints." TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Margin="6,0" Padding="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="2. Plan" />
                    <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Discover objects, define scope, and review conversion decisions." TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Margin="12,0,0,0" Padding="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="3. Execute" />
                    <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Deploy, transfer, validate, and issue reports." TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </UniformGrid>
    </Grid>
</UserControl>
