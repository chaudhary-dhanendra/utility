<UserControl x:Class="MigrationStudio.Desktop.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:MigrationStudio.Desktop.Behaviors">
    <UserControl.Resources>
        <Style TargetType="TextBox"><Setter Property="Margin" Value="4" /><Setter Property="Padding" Value="6,4" /></Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="4" /><Setter Property="Padding" Value="5,3" /></Style>
        <Style TargetType="Button"><Setter Property="Margin" Value="4" /><Setter Property="Padding" Value="12,6" /></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="6,4" /></Style>
        <Style TargetType="GroupBox"><Setter Property="Margin" Value="4" /><Setter Property="Padding" Value="8" /></Style>
    </UserControl.Resources>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding Title}" />
                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Status}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding LoadInventoryCommand}" Content="Open inventory" />
                <Button Command="{Binding SaveInventoryCommand}" Content="Save inventory" />
            </StackPanel>
        </Grid>

        <TabControl x:Name="WorkspaceTabs" SelectedIndex="{Binding SelectedWorkspaceTabIndex, Mode=TwoWay}">
            <TabItem Header="1  Connection">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="14" MaxWidth="900" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="340" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Server" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Port" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Port}" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Authentication" />
                        <CheckBox Grid.Row="2" Grid.Column="1" Content="Windows integrated security" IsChecked="{Binding UseWindowsAuthentication}" />
                        <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="User name" />
                        <TextBox Grid.Row="3" Grid.Column="1" IsEnabled="{Binding UseWindowsAuthentication, Converter={StaticResource InverseBooleanConverter}}" Text="{Binding Username}" />
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Password" />
                        <PasswordBox Grid.Row="4" Grid.Column="1" AutomationProperties.Name="SQL Server password" IsEnabled="{Binding UseWindowsAuthentication, Converter={StaticResource InverseBooleanConverter}}"
                                     behaviors:PasswordBoxBinding.Password="{Binding Password, Mode=TwoWay}" />
                        <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Transport security" />
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                            <CheckBox Content="Encrypt" IsChecked="{Binding Encrypt}" />
                            <CheckBox Content="Trust server certificate" IsChecked="{Binding TrustServerCertificate}" />
                        </StackPanel>
                        <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Timeouts (connection / command)" />
                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Width="80" Text="{Binding ConnectionTimeoutSeconds}" />
                            <TextBox Width="80" Text="{Binding CommandTimeoutSeconds}" />
                        </StackPanel>
                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding TestConnectionCommand}" Content="Test connection" />
                            <Button Command="{Binding LoadDatabasesCommand}" Content="Load databases" />
                        </StackPanel>
                        <TextBlock Grid.Row="7" Grid.Column="2" Margin="8" VerticalAlignment="Center" Text="{Binding ConnectionStatus}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="8" VerticalAlignment="Center" Text="Source database" />
                        <ComboBox Grid.Row="8" Grid.Column="1" IsEditable="True" ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedDatabase}" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="2  Scope">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Migration scope" />
                        <ComboBox ItemsSource="{Binding ScopeModes}" SelectedItem="{Binding ScopeMode}" />
                        <TextBlock Margin="4,14,4,0" FontWeight="SemiBold" Text="Dependency closure" />
                        <ComboBox ItemsSource="{Binding DependencyPolicies}" SelectedItem="{Binding DependencyPolicy}" />
                        <Button Margin="4,18,4,4" Command="{Binding ApplyScopeCommand}" Content="Apply selection" />
                    </StackPanel>
                    <GroupBox Grid.Column="1" Header="Schemas">
                        <ListView ItemsSource="{Binding Schemas}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}">
                                        <TextBlock><Run Text="{Binding Name}" /><Run Text="  (" /><Run Text="{Binding ObjectCount}" /><Run Text=" objects)" /></TextBlock>
                                    </CheckBox>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="3  Excel selection">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="Workbook" />
                    <TextBox Grid.Column="1" IsReadOnly="True" Text="{Binding ExcelPath}" />
                    <Button Grid.Column="2" Command="{Binding BrowseExcelCommand}" Content="Browse…" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Worksheet" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Worksheets}" SelectedItem="{Binding SelectedWorksheet}" />
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Table column" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TableColumn}" ToolTip="Header name, Excel letter, or 1-based column number" />
                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                        <Button Command="{Binding MatchExcelCommand}" Content="Match inventory" />
                        <Button Command="{Binding CancelExcelCommand}" Content="Cancel" />
                        <Button Command="{Binding ExportExcelIssuesCommand}" Content="Export issues" />
                    </StackPanel>
                    <TabControl Grid.Row="3" Grid.ColumnSpan="3" Margin="0,10,0,0">
                        <TabItem Header="Summary"><TextBlock Margin="12" Text="{Binding ExcelStatus}" TextWrapping="Wrap" /></TabItem>
                        <TabItem Header="Unmatched">
                            <DataGrid AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding UnmatchedExcelRows}">
                                <DataGrid.Columns><DataGridTextColumn Binding="{Binding RowNumber}" Header="Row" /><DataGridTextColumn Width="*" Binding="{Binding OriginalValue}" Header="Value" /></DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Ambiguous">
                            <DataGrid AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding AmbiguousExcelRows}">
                                <DataGrid.Columns><DataGridTextColumn Binding="{Binding Entry.RowNumber}" Header="Row" /><DataGridTextColumn Width="*" Binding="{Binding Entry.OriginalValue}" Header="Value" /></DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="4  Discover">
                <StackPanel Margin="18" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Catalog discovery" />
                    <TextBlock Margin="0,8" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                               Text="Discovery uses version-aware, set-based SQL Server catalog queries. It runs off the UI thread, honors cancellation, and records inaccessible optional metadata as findings." />
                    <ProgressBar Height="18" Margin="0,12" Maximum="100" Value="{Binding Progress}" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                    <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                        <Button Command="{Binding StartDiscoveryCommand}" Content="Start discovery" />
                        <Button Command="{Binding CancelDiscoveryCommand}" Content="Cancel" />
                        <Button Command="{Binding RetryDiscoveryCommand}" Content="Retry discovery" />
                        <Button Command="{Binding ExportDiscoveryDiagnosticsCommand}" Content="Export sanitized diagnostics" />
                    </StackPanel>
                    <Border Margin="0,16,0,0" Padding="12" BorderThickness="1"
                            BorderBrush="#FFC00000" Background="#FFFFEEEE"
                            Visibility="{Binding IsDiscoveryFailureVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.ColumnSpan="2" FontWeight="Bold" Foreground="#FF8B0000"
                                       Text="SQL Server discovery failed" />
                            <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Stage" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiscoveryFailureStage}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Query ID" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DiscoveryFailureQueryId}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="SQL error" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DiscoveryFailureErrorCode}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="Summary" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DiscoveryFailureSummary}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="5" FontWeight="SemiBold" Text="Remediation" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DiscoveryFailureRemediation}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="6" FontWeight="SemiBold" Text="Correlation" />
                            <TextBlock Grid.Row="6" Grid.Column="1" FontFamily="Consolas"
                                       Text="{Binding DiscoveryCorrelationId}" TextWrapping="Wrap" />
                            <Expander Grid.Row="7" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                      Header="Sanitized technical details">
                                <TextBox MaxHeight="160" Padding="6" IsReadOnly="True"
                                         FontFamily="Consolas" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding DiscoveryFailureDetails}" />
                            </Expander>
                        </Grid>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="5  Inventory">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="170" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                    <Grid Grid.ColumnSpan="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by qualified name or object type" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding DisplayedObjectCount, StringFormat={}{0:N0} displayed}"
                                   ToolTip="{Binding LastInventoryFilterMilliseconds, StringFormat=Last filter: {0:N1} ms}" />
                    </Grid>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False" ItemsSource="{Binding Objects}" SelectedItem="{Binding SelectedObject}"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected}" Header="Include" />
                            <DataGridTextColumn Width="2*" Binding="{Binding Name}" Header="Object" IsReadOnly="True" />
                            <DataGridTextColumn Width="*" Binding="{Binding Type}" Header="Type" IsReadOnly="True" />
                            <DataGridTextColumn Width="*" Binding="{Binding Classification}" Header="Conversion" IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding Dependencies}" Header="Uses" IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding Dependents}" Header="Used by" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GroupBox Grid.Row="1" Grid.Column="1" Header="Inspector">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding SelectedObject.Name}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding SelectedObject.Type, StringFormat=Type: {0}}" />
                            <TextBlock Text="{Binding SelectedObject.Classification, StringFormat=Classification: {0}}" />
                            <TextBlock Text="{Binding SelectedObject.Item.DiscoveryStatus, StringFormat=Discovery: {0}}" />
                            <TextBlock Text="{Binding SelectedObject.Item.MetadataHash, StringFormat=Metadata hash: {0}}" TextWrapping="Wrap" />
                            <TextBox Margin="0,10,0,0" Height="80" IsReadOnly="True" Text="{Binding SelectedObject.Item.SourceDefinition}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </GroupBox>
                    <TabControl Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
                        <TabItem Header="Dependencies">
                            <DataGrid AutoGenerateColumns="True" IsReadOnly="True" ItemsSource="{Binding Dependencies}" />
                        </TabItem>
                        <TabItem Header="Findings">
                            <DataGrid AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Findings}">
                                <DataGrid.Columns><DataGridTextColumn Binding="{Binding Severity}" Header="Severity" /><DataGridTextColumn Binding="{Binding Code}" Header="Code" /><DataGridTextColumn Width="*" Binding="{Binding Message}" Header="Message" /></DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="6  Summary">
                <UniformGrid Margin="18" Columns="2" Rows="2">
                    <GroupBox Header="Discovered objects"><TextBlock Margin="12" FontSize="30" Text="{Binding ObjectCount, StringFormat=N0}" /></GroupBox>
                    <GroupBox Header="Included in scope"><TextBlock Margin="12" FontSize="30" Text="{Binding IncludedCount, StringFormat=N0}" /></GroupBox>
                    <GroupBox Header="Findings"><TextBlock Margin="12" FontSize="30" Text="{Binding FindingCount, StringFormat=N0}" /></GroupBox>
                    <GroupBox Header="Unresolved dependencies"><TextBlock Margin="12" FontSize="30" Text="{Binding UnresolvedDependencyCount, StringFormat=N0}" /></GroupBox>
                </UniformGrid>
            </TabItem>

            <TabItem Header="7  Convert">
                <DockPanel Margin="8">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="PostgreSQL conversion" />
                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ConversionStatus}" TextWrapping="Wrap" />
                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding IdentifierMappingStatus}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding StartConversionCommand}" Content="Convert selected inventory" />
                            <Button Command="{Binding CancelConversionCommand}" Content="Cancel conversion" />
                            <Button Command="{Binding ViewIdentifierMappingsCommand}" Content="View Identifier Mappings" />
                            <Button Command="{Binding ExportMappingReportCommand}" Content="Export Mapping Report" />
                            <Button Command="{Binding ValidateOnPostgreSqlCommand}" Content="Validate SQL" />
                            <Button Command="{Binding GenerateValidatedPackageCommand}" Content="Generate validated package" />
                            <Button Command="{Binding ExportPackageCommand}" Content="Export validated package…" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar DockPanel.Dock="Top" Height="12" Margin="0,0,0,8" Maximum="100" Value="{Binding Progress}" />
                    <TabControl SelectedIndex="{Binding SelectedConversionTabIndex, Mode=TwoWay}">
                        <TabItem Header="Options">
                            <Grid Margin="12" MaxWidth="900" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Target PostgreSQL version" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding PostgreSqlVersions}" SelectedItem="{Binding TargetPostgreSqlVersion}" />
                                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Identifier mode" />
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding IdentifierCaseModes}"
                                          SelectedItem="{Binding IdentifierCaseMode}"
                                          ToolTip="Preserved mixed-case PostgreSQL names are case-sensitive and must always be quoted." />
                                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Schema mapping mode" />
                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SchemaMappingModes}" SelectedItem="{Binding SchemaMappingMode}" />
                                <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Identity strategy" />
                                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding IdentityStrategies}" SelectedItem="{Binding IdentityStrategy}" />
                                <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Security strategy" />
                                <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding SecurityStrategies}" SelectedItem="{Binding SecurityStrategy}" />
                                <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Optional extensions" />
                                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                                    <CheckBox Content="pgcrypto" IsChecked="{Binding EnablePgCrypto}" />
                                    <CheckBox Content="PostGIS" IsChecked="{Binding EnablePostGis}" />
                                </StackPanel>
                                <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="PostgreSQL validation connection" />
                                <StackPanel Grid.Row="6" Grid.Column="1">
                                    <PasswordBox AutomationProperties.Name="PostgreSQL validation connection string" behaviors:PasswordBoxBinding.Password="{Binding PostgreSqlValidationConnectionString, Mode=TwoWay}"
                                                 ToolTip="Used only for explicit rollback-only live validation; never persisted." />
                                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="Held in memory only. Successful validation automatically publishes a fresh deployment package." />
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Schema mapping">
                            <DataGrid Margin="6" AutoGenerateColumns="False" ItemsSource="{Binding Schemas}">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Binding="{Binding IsExcluded}" Header="Exclude" />
                                    <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="Source schema" IsReadOnly="True" />
                                    <DataGridTextColumn Width="*" Binding="{Binding TargetSchema, UpdateSourceTrigger=PropertyChanged}" Header="Target schema" />
                                    <DataGridTextColumn Binding="{Binding ObjectCount}" Header="Objects" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="Identifier preview">
                            <DataGrid Margin="6" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding IdentifierMappings}"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="#FFD9EAD3" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MappingStatus}" Value="ReservedWordSafelyQuoted">
                                                <Setter Property="Background" Value="#FFFFF2CC" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MappingStatus}" Value="AutomaticallyShortened">
                                                <Setter Property="Background" Value="#FFF4B183" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MappingStatus}" Value="CollisionResolved">
                                                <Setter Property="Background" Value="#FFF4B183" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MappingStatus}" Value="BlockingConflict">
                                                <Setter Property="Background" Value="#FFC00000" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding MappingStatus}" Header="Status" />
                                    <DataGridTextColumn Binding="{Binding MappingAction}" Header="Action" />
                                    <DataGridTextColumn Binding="{Binding ObjectType}" Header="Type" />
                                    <DataGridTextColumn Width="2*" Binding="{Binding SourceQualifiedName}" Header="Source" />
                                    <DataGridTextColumn Width="2*" Binding="{Binding TargetQualifiedName}" Header="Target" />
                                    <DataGridTextColumn Binding="{Binding OriginalUtf8ByteLength}" Header="Source bytes" />
                                    <DataGridTextColumn Binding="{Binding TargetUtf8ByteLength}" Header="Target bytes" />
                                    <DataGridCheckBoxColumn Binding="{Binding WasShortened, Mode=OneWay}" Header="Shortened" IsReadOnly="True" />
                                    <DataGridCheckBoxColumn Binding="{Binding HadCollision, Mode=OneWay}" Header="Collision" IsReadOnly="True" />
                                    <DataGridCheckBoxColumn Binding="{Binding IsReservedWord, Mode=OneWay}" Header="Reserved" IsReadOnly="True" />
                                    <DataGridCheckBoxColumn Binding="{Binding AutoRecovered, Mode=OneWay}" Header="Auto-recovered" IsReadOnly="True" />
                                    <DataGridCheckBoxColumn Binding="{Binding ManualReviewRequired, Mode=OneWay}" Header="Manual review" IsReadOnly="True" />
                                    <DataGridTextColumn Binding="{Binding Severity}" Header="Severity" />
                                    <DataGridTextColumn Width="*" Binding="{Binding MappingReason}" Header="Reason" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="Datatype mapping">
                            <DataGrid Margin="6" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding TypeMappings}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="*" Binding="{Binding SourceType}" Header="SQL Server" />
                                    <DataGridTextColumn Width="2*" Binding="{Binding TargetType}" Header="PostgreSQL" />
                                    <DataGridTextColumn Width="*" Binding="{Binding Classification}" Header="Classification" />
                                    <DataGridTextColumn Width="*" Binding="{Binding RuleId}" Header="Rule" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="Object conversion">
                            <Grid Margin="6">
                                <Grid.RowDefinitions><RowDefinition Height="220" /><RowDefinition Height="*" /><RowDefinition Height="110" /></Grid.RowDefinitions>
                                <DataGrid AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding ConversionArtifacts}" SelectedItem="{Binding SelectedConversionArtifact}"
                                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="2*" Binding="{Binding Target, Mode=OneWay}" Header="Target object" />
                                        <DataGridTextColumn Binding="{Binding Phase, Mode=OneWay}" Header="Phase" />
                                        <DataGridTextColumn Binding="{Binding Classification, Mode=OneWay}" Header="Classification" />
                                        <DataGridTextColumn Binding="{Binding Validation, Mode=OneWay}" Header="Validation" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <GridSplitter Grid.Row="1" Height="5" VerticalAlignment="Top" HorizontalAlignment="Stretch" />
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="5" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <GroupBox Header="Source SQL">
                                        <TextBox x:Name="ConversionSourceSqlTextBox" AcceptsReturn="True" FontFamily="Consolas" FontSize="12"
                                                 HorizontalScrollBarVisibility="Auto" IsReadOnly="True"
                                                 Text="{Binding SelectedConversionArtifact.SourceSql, Mode=OneWay}"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </GroupBox>
                                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeDirection="Columns" />
                                    <GroupBox Grid.Column="2" Header="Generated PostgreSQL · editable manual-review copy">
                                        <TextBox AcceptsReturn="True" FontFamily="Consolas" FontSize="12" HorizontalScrollBarVisibility="Auto"
                                                 Text="{Binding SelectedConversionArtifact.GeneratedSql, UpdateSourceTrigger=PropertyChanged}" VerticalScrollBarVisibility="Auto" />
                                    </GroupBox>
                                </Grid>
                                <GroupBox Grid.Row="2" Header="Findings">
                                    <TextBox IsReadOnly="True" Text="{Binding SelectedConversionArtifact.Findings, Mode=OneWay}"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                </GroupBox>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Conversion summary">
                            <UniformGrid Margin="18" Columns="2" Rows="2">
                                <GroupBox Header="Automatic"><TextBlock Margin="12" FontSize="30" Text="{Binding AutomaticConversionCount, StringFormat=N0}" /></GroupBox>
                                <GroupBox Header="Automatic with warnings"><TextBlock Margin="12" FontSize="30" Text="{Binding WarningConversionCount, StringFormat=N0}" /></GroupBox>
                                <GroupBox Header="Manual review"><TextBlock Margin="12" FontSize="30" Text="{Binding ManualConversionCount, StringFormat=N0}" /></GroupBox>
                                <GroupBox Header="Unsupported"><TextBlock Margin="12" FontSize="30" Text="{Binding UnsupportedConversionCount, StringFormat=N0}" /></GroupBox>
                            </UniformGrid>
                        </TabItem>

                        <TabItem Header="Live validation">
                            <DockPanel Margin="8">
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Live PostgreSQL validation" />
                                    <TextBlock Text="{Binding LiveValidationStatus}" TextWrapping="Wrap" />
                                    <ProgressBar Height="14" Margin="0,8,0,4" Maximum="100"
                                                 Value="{Binding LiveValidationProgress}" />
                                    <WrapPanel>
                                        <TextBlock Margin="0,0,18,0" Text="{Binding LiveValidationCompleted, StringFormat=Completed: {0:N0}}" />
                                        <TextBlock Margin="0,0,18,0" Text="{Binding LiveValidationTotal, StringFormat=Total: {0:N0}}" />
                                        <TextBlock Text="{Binding LiveValidationCurrentObject, StringFormat=Current: {0}}" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Margin="0,0,18,0" Text="{Binding LiveValidationPassedCount, StringFormat=Passed: {0:N0}}" />
                                        <TextBlock Margin="0,0,18,0" Text="{Binding LiveValidationFailedCount, StringFormat=Failed: {0:N0}}" />
                                        <TextBlock Margin="0,0,18,0" Text="{Binding LiveValidationBlockedCount, StringFormat=Blocked: {0:N0}}" />
                                        <TextBlock Margin="0,0,18,0" Text="{Binding LiveValidationNotRunCount, StringFormat=Not run: {0:N0}}" />
                                        <TextBlock Margin="0,0,18,0" Text="{Binding LiveValidationManualReviewCount, StringFormat=Manual: {0:N0}}" />
                                        <TextBlock Text="{Binding LiveValidationReusedCount, StringFormat=Reused: {0:N0}}" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,8">
                                        <Button Command="{Binding ValidateOnPostgreSqlCommand}" Content="Validate SQL" />
                                        <Button Command="{Binding ExportLiveValidationReportCommand}" Content="Export validation report" />
                                        <Button Command="{Binding GenerateValidatedPackageCommand}" Content="Generate validated package" />
                                    </WrapPanel>
                                </StackPanel>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="2*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DataGrid AutoGenerateColumns="False" IsReadOnly="True"
                                              ItemsSource="{Binding LiveValidationFailures}"
                                              SelectedItem="{Binding SelectedLiveValidationFailure}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="2*" Binding="{Binding ObjectName}" Header="Object" />
                                            <DataGridTextColumn Binding="{Binding Script}" Header="Script" />
                                            <DataGridTextColumn Binding="{Binding SqlState}" Header="SQLSTATE" />
                                            <DataGridTextColumn Binding="{Binding LineNumber}" Header="Line" />
                                            <DataGridTextColumn Width="2*" Binding="{Binding Dependency}" Header="Dependency" />
                                            <DataGridTextColumn Width="3*" Binding="{Binding PostgreSqlError}" Header="PostgreSQL error" />
                                            <DataGridTextColumn Width="3*" Binding="{Binding SuggestedFix}" Header="Suggested fix" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBox Grid.Row="1" Margin="0,8,0,0" IsReadOnly="True"
                                             FontFamily="Consolas" AcceptsReturn="True"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"
                                             Text="{Binding SelectedLiveValidationFailure.GeneratedSql, Mode=OneWay}" />
                                </Grid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </TabItem>

            <TabItem Header="8  Data migration">
                <DockPanel Margin="8">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Streaming data migration" />
                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding DataMigrationStatus}" TextWrapping="Wrap" />
                            <TextBlock FontFamily="Consolas" Text="{Binding MigrationRunId, StringFormat=Run ID: {0}}" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1">
                            <Button Command="{Binding PreviewDataPlanCommand}" Content="Preview plan" />
                            <Button Command="{Binding StartDataMigrationCommand}" Content="Start" />
                            <Button Command="{Binding PauseDataMigrationCommand}" Content="Pause" />
                            <Button Command="{Binding ContinueDataMigrationCommand}" Content="Continue" />
                            <Button Command="{Binding CancelDataMigrationCommand}" Content="Cancel" />
                            <Button Command="{Binding ResumeDataMigrationCommand}" Content="Resume checkpoint" />
                            <Button Command="{Binding ExportDataReportCommand}" Content="Export report" />
                        </WrapPanel>
                    </Grid>

                    <UniformGrid DockPanel.Dock="Top" Columns="7" Margin="0,0,0,8">
                        <GroupBox Header="Rows read"><TextBlock FontSize="18" Text="{Binding TotalRowsRead, StringFormat=N0}" /></GroupBox>
                        <GroupBox Header="Rows written"><TextBlock FontSize="18" Text="{Binding TotalRowsWritten, StringFormat=N0}" /></GroupBox>
                        <GroupBox Header="Rejected"><TextBlock FontSize="18" Text="{Binding TotalRowsRejected, StringFormat=N0}" /></GroupBox>
                        <GroupBox Header="Rows/sec"><TextBlock FontSize="18" Text="{Binding DataRowsPerSecond, StringFormat=N0}" /></GroupBox>
                        <GroupBox Header="Bytes/sec"><TextBlock FontSize="18" Text="{Binding DataBytesPerSecond, StringFormat=N0}" /></GroupBox>
                        <GroupBox Header="Readers"><TextBlock FontSize="18" Text="{Binding ActiveReaders}" /></GroupBox>
                        <GroupBox Header="Writers"><TextBlock FontSize="18" Text="{Binding ActiveWriters}" /></GroupBox>
                    </UniformGrid>

                    <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8"
                            BorderBrush="#808080" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="Current stage" />
                            <TextBlock Grid.Column="1" Margin="8,0" Text="{Binding StreamingCurrentStage, Mode=OneWay}" />
                            <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Current table" />
                            <TextBlock Grid.Column="3" Margin="8,0" Text="{Binding StreamingCurrentTable, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Current batch" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="8,0" Text="{Binding StreamingCurrentBatch, Mode=OneWay}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" FontWeight="SemiBold" Text="Last successful stage" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Margin="8,0" Text="{Binding StreamingLastSuccessfulStage, Mode=OneWay}" />
                            <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Current reader" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="8,0" Text="{Binding StreamingCurrentReader, Mode=OneWay}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" FontWeight="SemiBold" Text="Current writer" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Margin="8,0" Text="{Binding StreamingCurrentWriter, Mode=OneWay}" />
                            <TextBlock Grid.Row="3" FontWeight="SemiBold" Foreground="#B42318" Text="Failure stage" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="8,0" Foreground="#B42318"
                                       Text="{Binding StreamingFailureStage, Mode=OneWay}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" FontWeight="SemiBold" Text="Failure component" />
                            <TextBlock Grid.Row="3" Grid.Column="3" Margin="8,0"
                                       Text="{Binding StreamingFailureComponent, Mode=OneWay}" />
                            <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="Failure reason" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Margin="8,0"
                                       Text="{Binding StreamingFailureReason, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="5" FontWeight="SemiBold" Text="Remediation" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Margin="8,0"
                                       Text="{Binding StreamingRemediation, Mode=OneWay}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <TabControl x:Name="DataMigrationTabs">
                        <TabItem Header="Options">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="12" MaxWidth="920" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="420" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <GroupBox Grid.ColumnSpan="2" Header="PostgreSQL target connection">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="360" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock VerticalAlignment="Center" Text="Host" />
                                            <TextBox x:Name="PostgreSqlTargetHostTextBox" Grid.Column="1" AutomationProperties.Name="PostgreSQL host"
                                                     Text="{Binding PostgreSqlTarget.Host, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="PostgreSQL server hostname or IP address." />
                                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Port" />
                                            <TextBox x:Name="PostgreSqlTargetPortTextBox" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="PostgreSQL port"
                                                     Text="{Binding PostgreSqlTarget.Port, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Default PostgreSQL port is 5432." />
                                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Database" />
                                            <TextBox x:Name="PostgreSqlTargetDatabaseTextBox" Grid.Row="2" Grid.Column="1" AutomationProperties.Name="PostgreSQL target database"
                                                     Text="{Binding PostgreSqlTarget.Database, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Existing target database to receive the migrated schema and data." />
                                            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Username" />
                                            <TextBox x:Name="PostgreSqlTargetUsernameTextBox" Grid.Row="3" Grid.Column="1" AutomationProperties.Name="PostgreSQL username"
                                                     Text="{Binding PostgreSqlTarget.Username, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="PostgreSQL login role." />
                                            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Password" />
                                            <PasswordBox x:Name="PostgreSqlTargetPasswordBox" Grid.Row="4" Grid.Column="1" AutomationProperties.Name="PostgreSQL password"
                                                         Tag="{Binding PostgreSqlTarget, Mode=OneWay}"
                                                         PasswordChanged="PostgreSqlTargetPasswordBox_OnPasswordChanged"
                                                         ToolTip="Password is not included in exported diagnostics." />
                                            <Button x:Name="TestPostgreSqlTargetConnectionButton" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left"
                                                    Command="{Binding PostgreSqlTarget.TestPostgreSqlConnectionCommand}"
                                                    Content="Test Connection"
                                                    ToolTip="Verifies authentication and reads basic target-server information." />
                                            <Expander Grid.Row="6" Grid.ColumnSpan="2" Header="Advanced connection settings">
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="360" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="Use SSL" />
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding PostgreSqlTarget.UseSsl}" />
                                                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="SSL mode" />
                                                    <ComboBox Grid.Row="1" Grid.Column="1"
                                                              IsEnabled="{Binding PostgreSqlTarget.UseSsl}"
                                                              ItemsSource="{Binding PostgreSqlTarget.SslModes}"
                                                              SelectedItem="{Binding PostgreSqlTarget.SelectedSslMode}" />
                                                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Certificate validation" />
                                                    <CheckBox Grid.Row="2" Grid.Column="1"
                                                              Content="Trust server certificate"
                                                              IsChecked="{Binding PostgreSqlTarget.TrustServerCertificate}"
                                                              IsEnabled="{Binding PostgreSqlTarget.UseSsl}" />
                                                    <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Timeouts (connection / command)" />
                                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                                        <TextBox Width="90" Text="{Binding PostgreSqlTarget.ConnectionTimeoutSeconds}" />
                                                        <TextBox Width="90" Text="{Binding PostgreSqlTarget.CommandTimeoutSeconds}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Pooling" />
                                                    <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding PostgreSqlTarget.Pooling}" />
                                                </Grid>
                                            </Expander>
                                            <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Margin="4,8,4,4"
                                                       AutomationProperties.Name="PostgreSQL connection status"
                                                       Text="{Binding PostgreSqlTarget.ConnectionStatus, Mode=OneWay}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </GroupBox>
                                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Migration mode" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding DataMigrationModes}" SelectedItem="{Binding DataMigrationMode}" />
                                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Execution mode" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding DataExecutionModes}" SelectedItem="{Binding DataExecutionMode}" />
                                    <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Parallelism" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding DataParallelismModes}" SelectedItem="{Binding DataParallelismMode}" />
                                    <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Table / reader / writer limits" />
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Width="75" Text="{Binding MaximumConcurrentTables}" />
                                        <TextBox Width="75" Text="{Binding MaximumConcurrentReaders}" />
                                        <TextBox Width="75" Text="{Binding MaximumConcurrentWriters}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Batch rows / bytes" />
                                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Width="110" Text="{Binding BatchRowCount}" />
                                        <TextBox Width="160" Text="{Binding BatchByteSize}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Load ordering" />
                                    <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding LoadOrderings}" SelectedItem="{Binding LoadOrdering}" />
                                    <TextBlock Grid.Row="7" VerticalAlignment="Center" Text="Target preparation" />
                                    <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding TargetPreparations}" SelectedItem="{Binding TargetPreparation}" />
                                    <TextBlock Grid.Row="8" VerticalAlignment="Center" Text="Destructive operation confirmation" />
                                    <CheckBox Grid.Row="8" Grid.Column="1" Content="I explicitly authorize truncate, delete, or recreate when selected"
                                              IsChecked="{Binding DestructivePreparationConfirmed}" />
                                    <TextBlock Grid.Row="9" VerticalAlignment="Center" Text="Failure policy" />
                                    <ComboBox Grid.Row="9" Grid.Column="1" ItemsSource="{Binding MigrationFailurePolicies}" SelectedItem="{Binding MigrationFailurePolicy}" />
                                    <TextBlock Grid.Row="10" VerticalAlignment="Center" Text="Logical checksum" />
                                    <ComboBox Grid.Row="10" Grid.Column="1" ItemsSource="{Binding ChecksumModes}" SelectedItem="{Binding ChecksumMode}" />
                                    <TextBlock Grid.Row="11" VerticalAlignment="Center" Text="Additional validation" />
                                    <CheckBox Grid.Row="11" Grid.Column="1" Content="Compare per-column null counts" IsChecked="{Binding ValidateNullCounts}" />
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Table load plan and checkpoints">
                            <Grid Margin="6">
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <DataGrid x:Name="DataMigrationTablePlanGrid" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding DataTables}"
                                          SelectedItem="{Binding SelectedDataTable}" EnableRowVirtualization="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="2*" Binding="{Binding Table}" Header="Source table" />
                                        <DataGridTextColumn Width="2*" Binding="{Binding Target}" Header="Target table" />
                                        <DataGridTextColumn Binding="{Binding State}" Header="State" />
                                        <DataGridTextColumn Binding="{Binding Strategy}" Header="Strategy" />
                                        <DataGridTextColumn Binding="{Binding RowsRead}" Header="Read" />
                                        <DataGridTextColumn Binding="{Binding RowsWritten}" Header="Written" />
                                        <DataGridTextColumn Binding="{Binding RowsRejected}" Header="Rejected" />
                                        <DataGridTextColumn Binding="{Binding CurrentBatch}" Header="Batch" />
                                        <DataGridTextColumn Binding="{Binding RetryCount}" Header="Retries" />
                                        <DataGridCheckBoxColumn Binding="{Binding IsResumable, Mode=OneWay}" Header="Resumable" IsReadOnly="True" />
                                        <DataGridCheckBoxColumn Binding="{Binding IsSensitive, Mode=OneWay}" Header="Sensitive" IsReadOnly="True" />
                                        <DataGridTextColumn Binding="{Binding Validation}" Header="Validation" />
                                        <DataGridTextColumn Width="2*" Binding="{Binding Message}" Header="Status" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Grid.Row="1" HorizontalAlignment="Left" Command="{Binding RestartDataTableCommand}"
                                        Content="Clear selected table checkpoint and restart" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="Failures">
                            <DataGrid Margin="6" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding DataFailures}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="2*" Binding="{Binding Table}" Header="Table" />
                                    <DataGridTextColumn Binding="{Binding Batch}" Header="Batch" />
                                    <DataGridTextColumn Binding="{Binding RowOrdinal}" Header="Row" />
                                    <DataGridTextColumn Binding="{Binding SqlState}" Header="SQLSTATE" />
                                    <DataGridTextColumn Binding="{Binding Category}" Header="Category" />
                                    <DataGridTextColumn Binding="{Binding Disposition}" Header="Disposition" />
                                    <DataGridTextColumn Width="3*" Binding="{Binding SanitizedMessage}" Header="Redacted error" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="Validation">
                            <DataGrid Margin="6" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding DataValidations}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="2*" Binding="{Binding Table}" Header="Table" />
                                    <DataGridTextColumn Binding="{Binding SourceRowCount}" Header="Source rows" />
                                    <DataGridTextColumn Binding="{Binding TargetRowCount}" Header="Target rows" />
                                    <DataGridTextColumn Binding="{Binding Outcome}" Header="Outcome" />
                                    <DataGridTextColumn Binding="{Binding Duration}" Header="Duration" />
                                    <DataGridTextColumn Width="3*" Binding="{Binding Message}" Header="Message" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="Sequence resets">
                            <DataGrid Margin="6" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding SequenceResets}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="2*" Binding="{Binding Table}" Header="Table" />
                                    <DataGridTextColumn Binding="{Binding Column}" Header="Identity column" />
                                    <DataGridTextColumn Binding="{Binding SourceMaximum}" Header="Source boundary" />
                                    <DataGridTextColumn Binding="{Binding TargetMaximum}" Header="Target boundary" />
                                    <DataGridTextColumn Binding="{Binding RestartValue}" Header="Selected value" />
                                    <DataGridTextColumn Binding="{Binding Increment}" Header="Increment" />
                                    <DataGridTextColumn Width="3*" Binding="{Binding Script}" Header="Executed reset script" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </TabItem>

            <TabItem Header="9  Deploy">
                <DockPanel Margin="8">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="PostgreSQL deployment and execution" />
                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding DeploymentStatus}" TextWrapping="Wrap" />
                            <TextBlock FontFamily="Consolas" Text="{Binding DeploymentId, StringFormat=Deployment ID: {0}}" />
                            <TextBlock Text="{Binding DeploymentCurrentObject, StringFormat=Current object: {0}}" TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1">
                            <Button Command="{Binding BrowseDeploymentPackageCommand}" Content="Select package" />
                            <Button Command="{Binding TestDeploymentConnectionCommand}" Content="Test target" />
                            <Button Command="{Binding AssessDeploymentCommand}" Content="Assess" />
                            <Button Command="{Binding StartDeploymentCommand}" Content="Deploy" />
                            <Button Command="{Binding CancelDeploymentCommand}" Content="Cancel" />
                            <Button Command="{Binding ResumeDeploymentCommand}" Content="Resume" />
                            <Button Command="{Binding RetryFailedDeploymentObjectsCommand}" Content="Retry failed" />
                            <Button Command="{Binding ExportDeploymentReportCommand}" Content="Export report" />
                        </WrapPanel>
                    </Grid>
                    <ProgressBar DockPanel.Dock="Top" Height="12" Margin="0,0,0,8" Maximum="100" Value="{Binding DeploymentProgress}" />
                    <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,8">
                        <GroupBox Header="Completed"><TextBlock FontSize="18" Text="{Binding DeploymentCompleted}" /></GroupBox>
                        <GroupBox Header="Failed"><TextBlock FontSize="18" Text="{Binding DeploymentFailed}" /></GroupBox>
                        <GroupBox Header="Skipped"><TextBlock FontSize="18" Text="{Binding DeploymentSkipped}" /></GroupBox>
                        <GroupBox Header="Server version"><TextBlock FontSize="18" Text="{Binding DeploymentServerVersion}" /></GroupBox>
                    </UniformGrid>
                    <TabControl>
                        <TabItem Header="Manifest summary">
                            <Grid Margin="18" MaxWidth="760" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="420" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Package ID" /><TextBlock Grid.Column="1" FontFamily="Consolas" Text="{Binding DeploymentPackageId}" />
                                <TextBlock Grid.Row="1" Text="Source database" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeploymentSourceDatabase}" />
                                <TextBlock Grid.Row="2" Text="Target PostgreSQL version" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DeploymentTargetVersion}" />
                                <TextBlock Grid.Row="3" Text="Structured artifacts" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DeploymentArtifactCount}" />
                                <TextBlock Grid.Row="4" Text="Manual-review items" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DeploymentManualReviewCount}" />
                                <TextBlock Grid.Row="5" Text="Package integrity valid" /><CheckBox Grid.Row="5" Grid.Column="1" IsEnabled="False" IsChecked="{Binding DeploymentPackageIntegrityValid, Mode=OneWay}" />
                                <TextBlock Grid.Row="6" Text="Target user schemas" /><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DeploymentTargetSchemaCount}" />
                                <TextBlock Grid.Row="7" Text="Target user tables" /><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding DeploymentTargetTableCount}" />
                                <TextBlock Grid.Row="8" Text="Existing target conflicts" /><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding DeploymentConflicts.Count}" />
                                <TextBlock Grid.Row="9" Text="Package duplicates" /><TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding DeploymentPackageDuplicateCount}" />
                            </Grid>
                        </TabItem>
                        <TabItem Header="Target and options">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="12" MaxWidth="980" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="480" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="Migration package" />
                                    <TextBox Grid.Column="1" IsReadOnly="True" Text="{Binding DeploymentPackagePath}" />
                                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Host / port" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Width="300" Text="{Binding DeploymentHost}" />
                                        <TextBox Width="100" Text="{Binding DeploymentPort}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Maintenance / target database" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Width="200" Text="{Binding MaintenanceDatabase}" />
                                        <TextBox Width="200" Text="{Binding DeploymentTargetDatabase}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Username / password" />
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Width="200" Text="{Binding DeploymentUsername}" />
                                        <PasswordBox Width="200" AutomationProperties.Name="PostgreSQL deployment password" behaviors:PasswordBoxBinding.Password="{Binding DeploymentPassword, Mode=TwoWay}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="SSL mode" />
                                    <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding DeploymentSslModes}" SelectedItem="{Binding DeploymentSslMode}" />
                                    <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Root / client certificate" />
                                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Width="200" Text="{Binding RootCertificate}" />
                                        <TextBox Width="200" Text="{Binding ClientCertificate}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Deployment mode / scope" />
                                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                                        <ComboBox Width="220" ItemsSource="{Binding DeploymentModes}" SelectedItem="{Binding DeploymentMode}" />
                                        <ComboBox Width="220" ItemsSource="{Binding DeploymentScopes}" SelectedItem="{Binding DeploymentScope}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="7" VerticalAlignment="Center" Text="Preflight / transactions" />
                                    <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                                        <ComboBox Width="220" ItemsSource="{Binding PreDeploymentPolicies}" SelectedItem="{Binding PreDeploymentPolicy}" />
                                        <ComboBox Width="220" ItemsSource="{Binding DeploymentTransactionModes}" SelectedItem="{Binding DeploymentTransactionMode}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="8" VerticalAlignment="Center" Text="Errors / existing conflicts" />
                                    <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                                        <ComboBox Width="220" ItemsSource="{Binding DeploymentErrorPolicies}" SelectedItem="{Binding DeploymentErrorPolicy}" />
                                        <ComboBox Width="220" ItemsSource="{Binding ConflictPolicies}" SelectedItem="{Binding ConflictPolicy}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="9" VerticalAlignment="Center" Text="Existing database policy" />
                                    <ComboBox Grid.Row="9" Grid.Column="1" ItemsSource="{Binding DatabaseExistsPolicies}" SelectedItem="{Binding DatabaseExistsPolicy}" />
                                    <TextBlock Grid.Row="10" VerticalAlignment="Center" Text="Destructive confirmation" />
                                    <CheckBox Grid.Row="10" Grid.Column="1"
                                              Content="I explicitly authorize the selected database/object destructive actions"
                                              IsChecked="{Binding DeploymentDestructiveConfirmed}" />
                                    <TextBlock Grid.Row="11" VerticalAlignment="Center" Text="Administrator override" />
                                    <CheckBox Grid.Row="11" Grid.Column="1" Content="Record and apply administrator override"
                                              IsChecked="{Binding AdministratorOverrideConfirmed}" />
                                    <TextBlock Grid.Row="12" VerticalAlignment="Center" Text="Override reason" />
                                    <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding AdministratorOverrideReason}" />
                                    <TextBlock Grid.Row="13" VerticalAlignment="Center" Text="Extension and maintenance actions" />
                                    <StackPanel Grid.Row="13" Grid.Column="1" Orientation="Horizontal">
                                        <CheckBox Content="Install required extensions" IsChecked="{Binding InstallRequiredExtensions}" />
                                        <CheckBox Content="ANALYZE tables" IsChecked="{Binding AnalyzeTables}" />
                                        <CheckBox Content="VACUUM ANALYZE (expensive)" IsChecked="{Binding VacuumAnalyze}" />
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Assessment">
                            <DataGrid Margin="6" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding DeploymentFindings}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Severity}" Header="Severity" />
                                    <DataGridTextColumn Binding="{Binding Code}" Header="Code" />
                                    <DataGridTextColumn Binding="{Binding Phase}" Header="Phase" />
                                    <DataGridTextColumn Width="3*" Binding="{Binding Message}" Header="Finding" />
                                    <DataGridCheckBoxColumn Binding="{Binding CanOverride, Mode=OneWay}" Header="Overrideable" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Required extensions">
                            <ListBox Margin="8" ItemsSource="{Binding DeploymentExtensions}" />
                        </TabItem>
                        <TabItem Header="Conflicts">
                            <DataGrid Margin="6" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding DeploymentConflicts}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="2*" Binding="{Binding TargetObject}" Header="Target object" />
                                    <DataGridTextColumn Binding="{Binding ObjectType}" Header="Type" />
                                    <DataGridCheckBoxColumn Binding="{Binding Exists, Mode=OneWay}" Header="Exists" IsReadOnly="True" />
                                    <DataGridCheckBoxColumn Binding="{Binding IsEquivalent, Mode=OneWay}" Header="Equivalent" IsReadOnly="True" />
                                    <DataGridCheckBoxColumn Binding="{Binding ContainsData, Mode=OneWay}" Header="Contains data" IsReadOnly="True" />
                                    <DataGridTextColumn Binding="{Binding SelectedPolicy}" Header="Policy" />
                                    <DataGridTextColumn Width="2*" Binding="{Binding Detail}" Header="Detail" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Package duplicates">
                            <DataGrid Margin="6" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding DeploymentPackageDuplicates}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding ObjectKind}" Header="Type" />
                                    <DataGridTextColumn Binding="{Binding TargetSchema}" Header="Schema" />
                                    <DataGridTextColumn Width="2*" Binding="{Binding TargetName}" Header="Target name" />
                                    <DataGridTextColumn Width="2*" Binding="{Binding TargetParentObject}" Header="Parent" />
                                    <DataGridTextColumn Width="2*" Binding="{Binding RoutineIdentityArguments}" Header="Routine signature" />
                                    <DataGridTextColumn Binding="{Binding SourceObjectIds.Count}" Header="Source objects" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Phase checklist">
                            <DataGrid Margin="6" AutoGenerateColumns="False" ItemsSource="{Binding DeploymentPhases}">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Binding="{Binding IsSelected}" Header="Deploy" />
                                    <DataGridTextColumn Width="2*" Binding="{Binding Phase}" Header="Phase" IsReadOnly="True" />
                                    <DataGridTextColumn Binding="{Binding Status}" Header="Status" IsReadOnly="True" />
                                    <DataGridTextColumn Binding="{Binding Completed}" Header="Completed" IsReadOnly="True" />
                                    <DataGridTextColumn Binding="{Binding Failed}" Header="Failed" IsReadOnly="True" />
                                    <DataGridTextColumn Binding="{Binding Skipped}" Header="Skipped" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Deployment journal">
                            <DataGrid Margin="6" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding DeploymentJournalEntries}"
                                      EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Phase}" Header="Phase" />
                                    <DataGridTextColumn Width="2*" Binding="{Binding TargetObject}" Header="Object" />
                                    <DataGridTextColumn Binding="{Binding Status}" Header="Status" />
                                    <DataGridTextColumn Binding="{Binding CommitStatus}" Header="Commit" />
                                    <DataGridTextColumn Binding="{Binding Retries.Count}" Header="Retries" />
                                    <DataGridTextColumn Width="3*" Binding="{Binding Message}" Header="Result / redacted error" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </TabItem>

            <TabItem Header="10  Validate">
                <DockPanel Margin="8">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Post-migration validation and reconciliation" />
                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ValidationStatus}" TextWrapping="Wrap" />
                            <TextBlock FontFamily="Consolas" Text="{Binding ValidationRunId, StringFormat=Validation run: {0}}" />
                            <TextBlock Text="{Binding ValidationCurrentObject, StringFormat=Current object: {0}}" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1">
                            <Button Command="{Binding RunValidationCommand}" Content="Run validation" />
                            <Button Command="{Binding CancelValidationCommand}" Content="Cancel" />
                            <Button Command="{Binding ExportValidationReportCommand}" Content="Export" />
                        </WrapPanel>
                    </Grid>
                    <ProgressBar DockPanel.Dock="Top" Height="12" Margin="0,0,0,8"
                                 Maximum="100" Value="{Binding ValidationProgress}" />
                    <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,8">
                        <GroupBox Header="Overall readiness">
                            <TextBlock FontSize="18" Text="{Binding ReadinessStatus}" />
                        </GroupBox>
                        <GroupBox Header="Explainable weighted score">
                            <TextBlock FontSize="18" Text="{Binding ReadinessScore, TargetNullValue=Not calculated}" />
                        </GroupBox>
                        <GroupBox Header="Critical blockers">
                            <TextBlock FontSize="18" Text="{Binding ValidationCriticalBlockers}" />
                        </GroupBox>
                    </UniformGrid>
                    <TabControl>
                        <TabItem Header="Configuration">
                            <Grid Margin="16" MaxWidth="900" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="480" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Validation level" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ValidationLevels}"
                                          SelectedItem="{Binding ValidationLevel}" />
                                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Tables without primary keys" />
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding KeylessValidationStrategies}"
                                          SelectedItem="{Binding KeylessValidationStrategy}" />
                                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Deterministic sample rows" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ValidationSampleSize}" />
                                <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Checksum chunk rows" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ValidationChunkSize}" />
                                <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Optional checks" />
                                <StackPanel Grid.Row="4" Grid.Column="1">
                                    <CheckBox Content="Run configured foreign-key orphan checks"
                                              IsChecked="{Binding ValidationForeignKeyOrphans}" />
                                    <CheckBox Content="Calculate distinct counts (can be expensive)"
                                              IsChecked="{Binding ValidationDistinctCounts}" />
                                </StackPanel>
                                <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Source scope" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="Uses the selected schemas and tables from this workspace." />
                                <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Margin="0,12,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                           Text="Routine and trigger execution is disabled by default. A programmable object remains incomplete until an administrator-approved, read-only or rollback-capable semantic test case has passed." />
                            </Grid>
                        </TabItem>
                        <TabItem Header="Category scorecards">
                            <DataGrid Margin="6" AutoGenerateColumns="False" IsReadOnly="True"
                                      ItemsSource="{Binding ValidationCategoryScores}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="2*" Binding="{Binding Category}" Header="Category" />
                                    <DataGridTextColumn Binding="{Binding Status}" Header="Status" />
                                    <DataGridTextColumn Binding="{Binding Score}" Header="Score" />
                                    <DataGridTextColumn Binding="{Binding Weight}" Header="Weight" />
                                    <DataGridTextColumn Binding="{Binding PassedChecks}" Header="Passed" />
                                    <DataGridTextColumn Binding="{Binding WarningChecks}" Header="Warnings" />
                                    <DataGridTextColumn Binding="{Binding BlockerChecks}" Header="Blockers" />
                                    <DataGridTextColumn Width="3*" Binding="{Binding Explanation}" Header="Explanation" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Object comparison">
                            <DataGrid Margin="6" AutoGenerateColumns="False" IsReadOnly="True"
                                      ItemsSource="{Binding ValidationObjectComparisons}"
                                      EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Severity}" Header="Severity" />
                                    <DataGridTextColumn Binding="{Binding Classification}" Header="Classification" />
                                    <DataGridTextColumn Binding="{Binding ObjectType}" Header="Type" />
                                    <DataGridTextColumn Width="2*" Binding="{Binding SourceName}" Header="Source (mapped)" />
                                    <DataGridTextColumn Width="2*" Binding="{Binding TargetName}" Header="Target" />
                                    <DataGridTextColumn Width="3*" Binding="{Binding Detail}" Header="Mismatch / transformation detail" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Data reconciliation">
                            <DataGrid Margin="6" AutoGenerateColumns="False" IsReadOnly="True"
                                      ItemsSource="{Binding ValidationDataComparisons}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="2*" Binding="{Binding SourceTable}" Header="Source table" />
                                    <DataGridTextColumn Width="2*" Binding="{Binding TargetTable}" Header="Target table" />
                                    <DataGridTextColumn Binding="{Binding SourceRowCount}" Header="Source rows" />
                                    <DataGridTextColumn Binding="{Binding TargetRowCount}" Header="Target rows" />
                                    <DataGridTextColumn Binding="{Binding Classification}" Header="Result" />
                                    <DataGridTextColumn Width="3*" Binding="{Binding Detail}" Header="Details (values masked)" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Sequence status">
                            <DataGrid Margin="6" AutoGenerateColumns="False" IsReadOnly="True"
                                      ItemsSource="{Binding ValidationSequences}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="2*" Binding="{Binding TargetSequence}" Header="Target sequence" />
                                    <DataGridTextColumn Binding="{Binding CurrentValue}" Header="Current" />
                                    <DataGridTextColumn Binding="{Binding MaximumColumnValue}" Header="Maximum key" />
                                    <DataGridTextColumn Binding="{Binding ExpectedNextValue}" Header="Expected next" />
                                    <DataGridCheckBoxColumn Binding="{Binding WouldGenerateDuplicate, Mode=OneWay}" Header="Duplicate risk" IsReadOnly="True" />
                                    <DataGridTextColumn Binding="{Binding Classification}" Header="Result" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Constraints and routines">
                            <DataGrid Margin="6" AutoGenerateColumns="False" IsReadOnly="True"
                                      ItemsSource="{Binding ValidationFindings}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Severity}" Header="Severity" />
                                    <DataGridTextColumn Binding="{Binding Category}" Header="Category" />
                                    <DataGridTextColumn Binding="{Binding Classification}" Header="Result" />
                                    <DataGridTextColumn Width="2*" Binding="{Binding SourceObject}" Header="Object" />
                                    <DataGridTextColumn Width="4*" Binding="{Binding Summary}" Header="Validation / manual review detail" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Definition comparison">
                            <DataGrid Margin="6" AutoGenerateColumns="False" IsReadOnly="True"
                                      ItemsSource="{Binding ValidationFindings}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="2*" Binding="{Binding SourceObject}" Header="Mapped object" />
                                    <DataGridTextColumn Binding="{Binding Classification}" Header="Result" />
                                    <DataGridTextColumn Width="4*" Binding="{Binding SourceDefinition}" Header="SQL Server definition" />
                                    <DataGridTextColumn Width="4*" Binding="{Binding TargetDefinition}" Header="PostgreSQL definition" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Routine test cases">
                            <DataGrid Margin="6" AutoGenerateColumns="False" IsReadOnly="True"
                                      ItemsSource="{Binding ValidationRoutineTestCases}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Id}" Header="Test ID" />
                                    <DataGridTextColumn Width="2*" Binding="{Binding Routine}" Header="Routine" />
                                    <DataGridCheckBoxColumn Binding="{Binding IsReadOnly, Mode=OneWay}" Header="Read only" IsReadOnly="True" />
                                    <DataGridCheckBoxColumn Binding="{Binding SourceExecutionAllowed, Mode=OneWay}" Header="Source allowed" IsReadOnly="True" />
                                    <DataGridCheckBoxColumn Binding="{Binding TargetExecutionAllowed, Mode=OneWay}" Header="Target allowed" IsReadOnly="True" />
                                    <DataGridCheckBoxColumn Binding="{Binding RollbackTransaction, Mode=OneWay}" Header="Rollback" IsReadOnly="True" />
                                    <DataGridTextColumn Binding="{Binding TimeoutSeconds}" Header="Timeout" />
                                    <DataGridTextColumn Width="3*" Binding="{Binding ExpectedResultColumns.Count}" Header="Expected shape columns" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Critical blockers and manual review">
                            <DataGrid Margin="6" AutoGenerateColumns="False" IsReadOnly="True"
                                      ItemsSource="{Binding ValidationFindings}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Severity}" Header="Severity" />
                                    <DataGridTextColumn Binding="{Binding RuleId}" Header="Rule" />
                                    <DataGridTextColumn Binding="{Binding Classification}" Header="Classification" />
                                    <DataGridTextColumn Width="2*" Binding="{Binding SourceObject}" Header="Source object" />
                                    <DataGridTextColumn Width="4*" Binding="{Binding Summary}" Header="Finding" />
                                    <DataGridCheckBoxColumn Binding="{Binding IsOverridden, Mode=OneWay}" Header="Override recorded" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </TabItem>

            <TabItem Header="Tools  Discovery Doctor">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="SemiBold"
                                   Text="Discovery Doctor and Database Compatibility Audit" />
                        <TextBlock Margin="0,5" Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Executes the exact production catalog commands independently. Only SQL Server metadata is read; ordinary table data is never scanned." />
                        <ProgressBar Height="14" Margin="0,8,0,4" Maximum="100"
                                     Value="{Binding DoctorProgress}" />
                        <TextBlock Text="{Binding DoctorStatus}" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,8,0,6">
                            <Button Command="{Binding RunQuickPreflightCommand}" Content="Quick Preflight" />
                            <Button Command="{Binding RunDiscoveryDoctorCommand}" Content="Run Discovery Doctor" />
                            <Button Command="{Binding RunCompatibilityAuditCommand}" Content="Compatibility audit" />
                            <Button Command="{Binding RetryDoctorQueryCommand}" Content="Retry selected query" />
                            <Button Command="{Binding CancelDoctorCommand}" Content="Cancel" />
                            <Button Command="{Binding ExportDoctorDiagnosticsCommand}" Content="Export sanitized diagnostics" />
                        </WrapPanel>
                        <UniformGrid Columns="4" Margin="0,2,0,6">
                            <TextBlock Text="{Binding DoctorRegisteredQueryCount, StringFormat=Registered: {0}}" />
                            <TextBlock Text="{Binding DoctorSelectedQueryCount, StringFormat=Selected: {0}}" />
                            <TextBlock Text="{Binding DoctorExecutedQueryCount, StringFormat=Executed: {0}}" />
                            <TextBlock Text="{Binding DoctorPassedQueryCount, StringFormat=Passed: {0}}" />
                            <TextBlock Text="{Binding DoctorFailedQueryCount, StringFormat=Failed: {0}}" />
                            <TextBlock Text="{Binding DoctorSkippedQueryCount, StringFormat=Skipped: {0}}" />
                            <TextBlock Text="{Binding DoctorCurrentQuery, StringFormat=Current query: {0}}" />
                            <TextBlock Text="{Binding DoctorCurrentStage, StringFormat=Current stage: {0}}" />
                        </UniformGrid>
                        <TextBlock FontWeight="SemiBold" Text="{Binding DoctorAuditSummary}" TextWrapping="Wrap" />
                        <ItemsControl Margin="0,4" ItemsSource="{Binding DoctorCapabilities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run FontWeight="SemiBold" Text="{Binding Name}" /><Run Text=": " />
                                        <Run Text="{Binding Value}" /><Run Text=" — " /><Run Text="{Binding Impact}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <DataGrid Grid.Row="1" Margin="0,8" AutoGenerateColumns="False" IsReadOnly="True"
                              ItemsSource="{Binding DoctorQueries}"
                              SelectedItem="{Binding SelectedDoctorQuery}"
                              EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="2*" Binding="{Binding Descriptor.QueryId}" Header="Query ID" />
                            <DataGridTextColumn Binding="{Binding Descriptor.Stage}" Header="Stage" />
                            <DataGridCheckBoxColumn Binding="{Binding Descriptor.IsRequired, Mode=OneWay}" Header="Required" IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding Status}" Header="Status" />
                            <DataGridTextColumn Binding="{Binding Attempt}" Header="Attempt" />
                            <DataGridTextColumn Binding="{Binding DurationMilliseconds}" Header="Milliseconds" />
                            <DataGridTextColumn Binding="{Binding ResultSetCount}" Header="Result sets" />
                            <DataGridTextColumn Binding="{Binding RowCount}" Header="Metadata rows" />
                            <DataGridTextColumn Binding="{Binding RowsMapped}" Header="Rows mapped" />
                            <DataGridTextColumn Binding="{Binding FailurePhase}" Header="Failure phase" />
                            <DataGridTextColumn Width="3*" Binding="{Binding Summary}" Header="Exact result / error" />
                            <DataGridTextColumn Width="3*" Binding="{Binding Remediation}" Header="Remediation" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TabControl Grid.Row="2">
                        <TabItem Header="Exact catalog query">
                            <TextBox Margin="6" IsReadOnly="True" FontFamily="Consolas"
                                     Text="{Binding SelectedDoctorQuery.Descriptor.QueryText}"
                                     TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto" />
                        </TabItem>
                        <TabItem Header="SQL Server errors">
                            <DataGrid Margin="6" AutoGenerateColumns="False" IsReadOnly="True"
                                      ItemsSource="{Binding SelectedDoctorQuery.Errors}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Number}" Header="Number" />
                                    <DataGridTextColumn Binding="{Binding State}" Header="State" />
                                    <DataGridTextColumn Binding="{Binding Class}" Header="Class" />
                                    <DataGridTextColumn Binding="{Binding Procedure}" Header="Procedure" />
                                    <DataGridTextColumn Binding="{Binding LineNumber}" Header="Line" />
                                    <DataGridTextColumn Width="*" Binding="{Binding Message}" Header="Message" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
